{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuvalrakavy/issue-dashboard/schemas/doc-suggestion.schema.json",
  "title": "Tracker document: suggestions",
  "description": "One open triage suggestion (5.8).",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/suggestionBody"
    }
  ],
  "required": [
    "id",
    "project",
    "run_id",
    "kind",
    "made_at",
    "confidence"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/docId"
    },
    "project": {
      "$ref": "common.schema.json#/$defs/projectName"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "type",
        "area",
        "priority",
        "likely_fixed",
        "duplicate",
        "combined",
        "obsolete",
        "support_question",
        "batch",
        "left_out"
      ]
    },
    "made_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "action_label": {
      "description": "What the main button says (5.2a), e.g. \"Set bug · p1\".",
      "type": "string",
      "minLength": 1
    },
    "badge": {
      "description": "The evaluation of the suggestion's own calibration map (triage spec 4.1, 3.5).",
      "enum": [
        "evaluated",
        "unevaluated",
        "uncalibrated",
        "drifting"
      ]
    },
    "bulk_ok": {
      "description": "Apply all may take this card (triage spec 4.3): an untriaged item's type, area or priority card on a key that passes Bulk and is not drifting.",
      "type": "boolean"
    },
    "card": {
      "description": "The card the suggestion is shown on: its own id, or the combined card an untriaged item's type and priority share (4.1).",
      "$ref": "common.schema.json#/$defs/docId"
    }
  },
  "unevaluatedProperties": false
}
