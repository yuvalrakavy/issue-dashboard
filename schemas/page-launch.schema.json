{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuvalrakavy/issue-dashboard/schemas/page-launch.schema.json",
  "title": "Page document: launches",
  "description": "A launch request, a not_sent record naming a refused one, or the launch thread's id (5.4). Never changed after it is written.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project",
        "author",
        "created_at",
        "kind",
        "items",
        "aliases",
        "recipe",
        "routing"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/docId"
        },
        "project": {
          "$ref": "common.schema.json#/$defs/projectName"
        },
        "author": {
          "description": "The page's user id of whoever wrote the document (10.5).",
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "kind": {
          "enum": [
            "fix",
            "batch",
            "review",
            "triage",
            "send_upstream",
            "go_back",
            "stronger_look",
            "design",
            "recommend_closures",
            "eval"
          ]
        },
        "scope": {
          "description": "A triage launch's scope (triage spec 5.1): every decision, or the closures only. Absent means full; only kind triage takes it.",
          "enum": [
            "full",
            "closures"
          ]
        },
        "items": {
          "description": "The items the launch names; an eval names none (it chooses its own sample, triage spec 3.2).",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/nodeId"
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/alias"
          }
        },
        "recipe": {
          "description": "The launch recipe (7.6) whose pool the launch takes a slot from.",
          "type": "string",
          "minLength": 1
        },
        "routing": {
          "$ref": "common.schema.json#/$defs/routing"
        },
        "suggested_routing": {
          "$ref": "common.schema.json#/$defs/routing"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "not": {
                  "const": "eval"
                }
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "minItems": 1
              },
              "aliases": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "triage"
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project",
        "author",
        "created_at",
        "not_sent"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/docId"
        },
        "project": {
          "$ref": "common.schema.json#/$defs/projectName"
        },
        "author": {
          "description": "The page's user id of whoever wrote the document (10.5).",
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "not_sent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "launch",
            "error"
          ],
          "properties": {
            "launch": {
              "$ref": "common.schema.json#/$defs/docId"
            },
            "error": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "description": "A thread record (5.4): one per launch thread, written once when the thread starts; the newest is the current thread. The first slice's single `_thread` record, rewritten on replacement, still reads as the oldest.",
      "required": [
        "id",
        "thread"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/docId"
        },
        "project": {
          "$ref": "common.schema.json#/$defs/projectName"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "thread": {
          "type": "string",
          "minLength": 1
        },
        "replaced_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    }
  ]
}
