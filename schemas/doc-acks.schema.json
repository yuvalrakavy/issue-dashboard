{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuvalrakavy/issue-dashboard/schemas/doc-acks.schema.json",
  "title": "Tracker document: acks",
  "description": "Which cycle consumed a page decision (10.6). One per decision, carried in every generation for 30 days.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "decision",
    "cycle",
    "result"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/docId"
    },
    "decision": {
      "$ref": "common.schema.json#/$defs/docId"
    },
    "cycle": {
      "type": "integer",
      "minimum": 1
    },
    "result": {
      "enum": [
        "applied",
        "refused",
        "cancelled"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
