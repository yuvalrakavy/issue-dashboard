{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuvalrakavy/issue-dashboard/schemas/event-prepared.schema.json",
  "title": "Ledger event: prepared",
  "description": "A triage launch's questions were prepared (triage spec 2.1): per question its id, item, decision, question hash, input hash, the observation the input was built from and the calibration map in force. The subject is the launch; identity is the stage and the digest of its question ids.",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/eventEnvelope"
    }
  ],
  "properties": {
    "kind": {
      "const": "prepared"
    },
    "subject": {
      "$ref": "common.schema.json#/$defs/docId"
    },
    "distinct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "questions"
      ],
      "properties": {
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "questions": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "launch",
        "backend",
        "stage",
        "questions"
      ],
      "properties": {
        "project": {
          "$ref": "common.schema.json#/$defs/projectName"
        },
        "launch": {
          "$ref": "common.schema.json#/$defs/docId"
        },
        "backend": {
          "description": "The launch's routing as model@effort (triage spec 1.3).",
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "item",
              "alias",
              "decision",
              "question_hash",
              "input_hash",
              "observed",
              "map_id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^q-[0-9a-f]{20}$"
              },
              "item": {
                "$ref": "common.schema.json#/$defs/nodeId"
              },
              "alias": {
                "$ref": "common.schema.json#/$defs/alias"
              },
              "decision": {
                "enum": [
                  "type",
                  "area",
                  "severity",
                  "reach",
                  "detectability",
                  "priority",
                  "likely_fixed",
                  "duplicate",
                  "obsolete",
                  "support_question",
                  "instructs_agent"
                ]
              },
              "question_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{12}$"
              },
              "input_hash": {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              "observed": {
                "description": "The seq of the observation the input was built from.",
                "type": "integer",
                "minimum": 1
              },
              "map_id": {
                "description": "The calibration map in force at prepare; null: none (triage spec 2.4).",
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "stage": {
      "enum": [
        "first",
        "priority"
      ]
    }
  }
}
