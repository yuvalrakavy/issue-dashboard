{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuvalrakavy/issue-dashboard/schemas/event-request.schema.json",
  "title": "Ledger event: request",
  "description": "A request, ingested from the page or recorded by sync-now: a brief preview, an on-demand triage, or a sync (10.8).",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/eventEnvelope"
    }
  ],
  "properties": {
    "kind": {
      "const": "request"
    },
    "subject": {
      "$ref": "common.schema.json#/$defs/docId"
    },
    "distinct": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "document"
      ],
      "properties": {
        "project": {
          "$ref": "common.schema.json#/$defs/projectName"
        },
        "document": {
          "$ref": "page-request.schema.json"
        }
      }
    }
  }
}
