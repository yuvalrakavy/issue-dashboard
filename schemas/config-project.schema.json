{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuvalrakavy/issue-dashboard/schemas/config-project.schema.json",
  "title": "Config: a project",
  "description": "<root>/projects/<project>.toml (1.1, 1.4): the project's members and its view of each, and the choices it makes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "owner_id",
    "member"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "dashboard": {
      "type": "string",
      "format": "uri"
    },
    "owner_id": {
      "description": "The page user id whose decisions count (10.5).",
      "type": "string",
      "minLength": 1
    },
    "maintainers": {
      "description": "GitHub usernames counted as inside (4.1).",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "member": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repo": {
            "$ref": "common.schema.json#/$defs/repoName"
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "exclude": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/repoName"
            }
          },
          "filter": {
            "type": "string",
            "not": {
              "pattern": "(^|\\s)(repo:|is:open|is:closed|is:pr|state:)"
            }
          },
          "also": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          },
          "read_only": {
            "type": "boolean"
          },
          "writes": {
            "enum": [
              "labels",
              "labels-and-comments"
            ]
          },
          "allow_public_comments": {
            "type": "boolean"
          }
        },
        "oneOf": [
          {
            "required": [
              "repo"
            ],
            "not": {
              "required": [
                "group"
              ]
            }
          },
          {
            "required": [
              "group"
            ],
            "not": {
              "required": [
                "repo"
              ]
            }
          }
        ],
        "dependentSchemas": {
          "exclude": {
            "required": [
              "group"
            ]
          }
        }
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "common.schema.json#/$defs/repoName"
        },
        "uniqueItems": true
      }
    },
    "default_view": {
      "type": "string",
      "minLength": 1
    },
    "history_days": {
      "type": "integer",
      "minimum": 1
    },
    "sync_interval_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "sync_task": {
      "description": "The id of the app's scheduled task that runs this project's sync job; sync-now prints it so the calling session can run the task now (7.2).",
      "type": "string",
      "minLength": 1
    },
    "max_writes_per_run": {
      "type": "integer",
      "minimum": 0
    },
    "max_batch": {
      "type": "integer",
      "minimum": 1
    },
    "time_limits_days": {
      "description": "Idle time allowed per priority before a breach (2.3).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "p0": {
          "type": "integer",
          "minimum": 1
        },
        "p1": {
          "type": "integer",
          "minimum": 1
        },
        "p2": {
          "type": "integer",
          "minimum": 1
        },
        "p3": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "routing": {
      "description": "Overrides of the default routing table (7.4), by launch kind.",
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/routing"
      }
    },
    "voice": {
      "type": "string",
      "minLength": 1
    },
    "disclose_drafting": {
      "type": "boolean"
    },
    "demand_threshold": {
      "type": "integer",
      "minimum": 1
    },
    "gate_minutes_per_point": {
      "type": "integer",
      "minimum": 1
    }
  }
}
