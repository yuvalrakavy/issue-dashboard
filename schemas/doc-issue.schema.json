{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuvalrakavy/issue-dashboard/schemas/doc-issue.schema.json",
  "title": "Tracker document: issues",
  "description": "One issue or pull request: the snapshot row (2.4) plus its rank and score terms (chapter 6). The document id is the node id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "alias",
    "kind",
    "title",
    "state",
    "type",
    "areas",
    "modifiers",
    "priority",
    "status",
    "created_at",
    "updated_at",
    "idle_days",
    "limit_breached",
    "links",
    "commits",
    "author",
    "outside",
    "rank",
    "score",
    "closed_at"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/nodeId"
    },
    "alias": {
      "$ref": "common.schema.json#/$defs/alias"
    },
    "kind": {
      "enum": [
        "issue",
        "pull_request"
      ]
    },
    "title": {
      "type": "string"
    },
    "state": {
      "enum": [
        "open",
        "closed",
        "merged"
      ]
    },
    "type": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/type"
        },
        {
          "type": "null"
        }
      ]
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "modifiers": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/modifier"
      },
      "uniqueItems": true
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "source",
        "label",
        "project",
        "override"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/priority"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "override",
                "project",
                "label"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/priority"
            },
            {
              "type": "null"
            }
          ]
        },
        "project": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/priority"
            },
            {
              "type": "null"
            }
          ]
        },
        "override": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "reason"
              ],
              "properties": {
                "value": {
                  "$ref": "common.schema.json#/$defs/priority"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "stale": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "effective": {
          "description": "After blocker elevation (6.1).",
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/priority"
            },
            {
              "type": "null"
            }
          ]
        },
        "github_shows": {
          "description": "The label when another project set it (1.5).",
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/priority"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "status": {
      "enum": [
        "new",
        "untriaged",
        "needs-decision",
        "in-progress",
        "blocked",
        "ready",
        "umbrella",
        "draft",
        "conflicting",
        "checks-failing",
        "waiting-on-author",
        "checks-running",
        "approved",
        "needs-review",
        "closed",
        "merged"
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "idle_days": {
      "type": "integer",
      "minimum": 0
    },
    "limit_breached": {
      "type": "boolean"
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocked_by",
        "blocks",
        "parent",
        "children"
      ],
      "properties": {
        "blocked_by": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/alias"
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/alias"
          }
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/alias"
            },
            {
              "type": "null"
            }
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/alias"
          }
        }
      }
    },
    "commits": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/commit"
      }
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "outside": {
      "type": "boolean"
    },
    "rank": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "score": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cost_of_delay",
            "value",
            "time_criticality",
            "risk_opportunity",
            "job_size",
            "confidence",
            "score"
          ],
          "properties": {
            "cost_of_delay": {
              "type": "number",
              "minimum": 0
            },
            "value": {
              "type": "number",
              "minimum": 0
            },
            "time_criticality": {
              "type": "number",
              "minimum": 0
            },
            "risk_opportunity": {
              "type": "number",
              "minimum": 0
            },
            "job_size": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "score": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "untranslated_labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "launch": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/docId"
        },
        {
          "type": "null"
        }
      ]
    },
    "stale": {
      "type": "boolean"
    },
    "labels": {
      "description": "The item's GitHub labels as read, before translation.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "body": {
      "description": "The body, trimmed and cut at 8000 characters; null when empty. Outside text is data (4.2): the page shows it as plain text.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        {
          "type": "null"
        }
      ]
    },
    "body_truncated": {
      "description": "Whether the body was cut.",
      "type": "boolean"
    },
    "closed_at": {
      "description": "When the item was closed or merged; null while open. The Trends tab counts closes per week from it.",
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "dashboard_close": {
      "description": "The close the owner made from the dashboard and that still stands (10.10); null when there is none. undo_allowed: Undo would reopen it (the issue is still closed by that close and nobody has commented since).",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "reason",
            "at",
            "result",
            "undo_allowed"
          ],
          "properties": {
            "decision": {
              "$ref": "common.schema.json#/$defs/docId"
            },
            "reason": {
              "enum": [
                "completed",
                "not_planned",
                "duplicate"
              ]
            },
            "at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "result": {
              "enum": [
                "closed",
                "already_closed"
              ]
            },
            "undo_allowed": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "state_reason": {
      "description": "Why GitHub says an issue was closed (completed, not_planned, duplicate, reopened); null for a pull request or when GitHub gives none.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "closed_by": {
      "description": "The tracked pull requests whose closing references name this issue, by alias (5.8); issues only, empty when none.",
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/alias"
      }
    },
    "dismissed_at": {
      "description": "When the owner dismissed this closed item (dismiss_closed, 5.8), while it is still closed by the close that was dismissed; null otherwise. A dismissed item leaves every list of the page, but Trends still counts it.",
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "sessions": {
      "description": "The app's sessions matched to this item (10.10), newest activity first; absent or empty when none. Never the session's working directory or transcript.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "running",
          "last_active_at",
          "link",
          "match"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "running": {
            "type": "boolean"
          },
          "last_active_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "link": {
            "type": [
              "string",
              "null"
            ]
          },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "via"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "exact",
                  "probable"
                ]
              },
              "via": {
                "enum": [
                  "launch",
                  "pull_request",
                  "title",
                  "branch"
                ]
              }
            }
          }
        }
      }
    },
    "type_source": {
      "description": "Where type came from (triage spec 4.2): override > accepted suggestion > label. A suggestion's value is not on GitHub yet.",
      "anyOf": [
        {
          "enum": [
            "override",
            "suggestion",
            "label"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "areas_source": {
      "description": "Where areas came from (triage spec 4.2).",
      "anyOf": [
        {
          "enum": [
            "override",
            "suggestion",
            "label"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "triage": {
      "description": "Triage spec 4.5: the latest severity, reach and detectability answers, each with the owner's Details edit, and the estimates; the answers that need a stronger look (2.5) and the instructs_agent warning (spec 4.2).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "severity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "answer",
            "probabilities",
            "backend",
            "badge",
            "suggestion",
            "edited"
          ],
          "properties": {
            "answer": {
              "anyOf": [
                {
                  "enum": [
                    "cosmetic",
                    "degraded",
                    "wrong_result",
                    "hang_or_data_loss"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "probabilities": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "backend": {
              "type": [
                "string",
                "null"
              ]
            },
            "badge": {
              "anyOf": [
                {
                  "enum": [
                    "evaluated",
                    "unevaluated",
                    "uncalibrated",
                    "drifting"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "suggestion": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/docId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "edited": {
              "description": "The owner's Details edit; null: none.",
              "anyOf": [
                {
                  "enum": [
                    "cosmetic",
                    "degraded",
                    "wrong_result",
                    "hang_or_data_loss"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "reach": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "answer",
            "probabilities",
            "backend",
            "badge",
            "suggestion",
            "edited"
          ],
          "properties": {
            "answer": {
              "anyOf": [
                {
                  "enum": [
                    "one_corner",
                    "one_subsystem",
                    "most",
                    "all"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "probabilities": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "backend": {
              "type": [
                "string",
                "null"
              ]
            },
            "badge": {
              "anyOf": [
                {
                  "enum": [
                    "evaluated",
                    "unevaluated",
                    "uncalibrated",
                    "drifting"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "suggestion": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/docId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "edited": {
              "description": "The owner's Details edit; null: none.",
              "anyOf": [
                {
                  "enum": [
                    "one_corner",
                    "one_subsystem",
                    "most",
                    "all"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "detectability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "answer",
            "probabilities",
            "backend",
            "badge",
            "suggestion",
            "edited"
          ],
          "properties": {
            "answer": {
              "anyOf": [
                {
                  "enum": [
                    "silent",
                    "visible"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "probabilities": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "backend": {
              "type": [
                "string",
                "null"
              ]
            },
            "badge": {
              "anyOf": [
                {
                  "enum": [
                    "evaluated",
                    "unevaluated",
                    "uncalibrated",
                    "drifting"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "suggestion": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/docId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "edited": {
              "description": "The owner's Details edit; null: none.",
              "anyOf": [
                {
                  "enum": [
                    "silent",
                    "visible"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "estimates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sites",
            "read_at",
            "tier",
            "blast",
            "effort",
            "backend",
            "edited"
          ],
          "properties": {
            "sites": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "read_at": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/commit"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tier": {
              "anyOf": [
                {
                  "enum": [
                    "T0",
                    "T1",
                    "T2",
                    "T3"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "blast": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "effort": {
              "anyOf": [
                {
                  "enum": [
                    "S",
                    "M",
                    "L"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "backend": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "edited": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/estimatesEdit"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "description": "The latest recorded estimates (null fields: none recorded) and `edited`, the owner's Details edit merged (null: none; triage spec 4.1)."
        },
        "stronger_look": {
          "description": "The latest answers about the item that need a stronger look (triage spec 2.5), while the item is open and the owner has not accepted, edited or dismissed them.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decision",
              "answer",
              "confidence",
              "backend",
              "suggestion"
            ],
            "properties": {
              "decision": {
                "enum": [
                  "priority",
                  "type",
                  "duplicate",
                  "likely_fixed"
                ]
              },
              "answer": {
                "type": [
                  "string",
                  "boolean"
                ]
              },
              "confidence": {
                "description": "The calibrated top probability.",
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "backend": {
                "type": "string",
                "minLength": 1
              },
              "suggestion": {
                "$ref": "common.schema.json#/$defs/docId"
              }
            }
          }
        },
        "instructs_agent": {
          "description": "The latest instructs_agent answer was true (spec 4.2): the item's text tries to direct an agent. No card: a warning in Details and in the item's briefs.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "backend",
            "probability"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "backend": {
              "type": "string",
              "minLength": 1
            },
            "probability": {
              "description": "The calibrated probability of true.",
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  }
}
