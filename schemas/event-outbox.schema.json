{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuvalrakavy/issue-dashboard/schemas/event-outbox.schema.json",
  "title": "Ledger event: outbox",
  "description": "A cycle took its outbox sequence number (10.4 step 3): the event's own seq is that number, so it never goes back, rebuild included. The subject is the project.",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/eventEnvelope"
    }
  ],
  "properties": {
    "kind": {
      "const": "outbox"
    },
    "subject": {
      "$ref": "common.schema.json#/$defs/projectName"
    },
    "distinct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taken_at"
      ],
      "properties": {
        "taken_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "taken_at"
      ],
      "properties": {
        "project": {
          "$ref": "common.schema.json#/$defs/projectName"
        },
        "taken_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    }
  }
}
